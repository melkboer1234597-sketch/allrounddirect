{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "allrounddirect",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],

  "vars": {
    "ENVIRONMENT": "development"
  },

  // Vite production output. /api/* goes to Hono first; other routes use static assets + SPA fallback.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Placeholder D1 id until the production database is created in Cloudflare.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "allround-webshop-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],

  "dev": {
    "port": 8787,
    "local_protocol": "http"
  }
}
