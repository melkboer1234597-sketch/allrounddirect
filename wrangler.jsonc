{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "allrounddirect",
  "account_id": "6b3387c18299d307197d2a39a0d9093d",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],

  "vars": {
    // Production Worker defaults. Override locally via `.dev.vars`.
    "ENVIRONMENT": "production",
    "BETTER_AUTH_URL": "https://allrounddirect.com",
    "SITE_URL": "https://allrounddirect.com",
    "PUBLIC_SITE_URL": "https://allrounddirect.com",
    "EMAIL_FROM": "AllRound Direct <bestellingen@allrounddirect.com>",
    "EMAIL_REPLY_TO": "support@allrounddirect.com",
    "MOLLIE_MODE": "test",
    "MOLLIE_ALLOW_LIVE": "false",
    "MOLLIE_BLOCK_LIVE_REFUNDS": "true"
  },

  "routes": [
    { "pattern": "allrounddirect.com", "custom_domain": true },
    { "pattern": "www.allrounddirect.com", "custom_domain": true }
  ],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Worker runs first so www→apex 308 applies to all paths, then Hono/API or assets.
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloth",
      "database_id": "e41adef2-8318-483e-9847-de4cb71ca545",
      "migrations_dir": "drizzle",
      "remote": false
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "piccas",
      "remote": false
    }
  ],

  "dev": {
    "port": 8787,
    "local_protocol": "http"
  }
}
