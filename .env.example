# Frontend (Vite) – alleen publieke variabelen met VITE_ prefix
VITE_API_URL=/api
# Productie-origine zonder trailing slash. Nodig voor canonical, Open Graph en sitemap.
# Productie: https://allrounddirect.com
VITE_SITE_URL=
# Publieke Turnstile site key. Secret blijft server-side.
VITE_TURNSTILE_SITE_KEY=

# Worker / server-side alleen – NOOIT in frontendcode gebruiken
MOLLIE_API_KEY=
# test (standaard) of live. Live vereist MOLLIE_ALLOW_LIVE=true en ENVIRONMENT=production.
MOLLIE_MODE=test
MOLLIE_ALLOW_LIVE=false
# Zet true in CI/automated tests om live refunds hard te blokkeren.
MOLLIE_BLOCK_LIVE_REFUNDS=true
ADMIN_SESSION_SECRET=

# Better Auth (minimaal 32 tekens). Genereer een eigen secret per omgeving.
BETTER_AUTH_SECRET=
# Publieke site-origine (canonical, e-maillinks). Zelfde waarde als Cloudflare SITE_URL / PUBLIC_SITE_URL.
# Productie: https://allrounddirect.com
SITE_URL=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173

# Cloudflare Turnstile – secret ALLEEN op de worker. Siteverify is verplicht.
TURNSTILE_SECRET=

# Resend transactionele e-mail. Leeg in development → lokale outbox + console, geen crash.
# Production: wrangler secret put RESEND_API_KEY
# Productie-afzender (vars of secrets):
# EMAIL_FROM=AllRound Direct <bestellingen@allrounddirect.com>
# EMAIL_REPLY_TO=support@allrounddirect.com
RESEND_API_KEY=
EMAIL_FROM=AllRound Direct <bestellingen@allrounddirect.com>
EMAIL_REPLY_TO=support@allrounddirect.com

# Optioneel: later voor Drizzle Kit tegen remote D1
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_DATABASE_ID=
# CLOUDFLARE_D1_TOKEN=
